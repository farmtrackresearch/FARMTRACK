EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Free tier, no credit card: https://cloud.maptiler.com
# Copy this file to .env and put the real key there — .env is gitignored,
# this file is committed. Without a key the map falls back to raster
# OpenTopoMap: ~1s per tile and capped at zoom 17, too coarse to place fence
# vertices accurately. With it you get vector tiles and zoom 20.
EXPO_PUBLIC_MAPTILER_KEY=
