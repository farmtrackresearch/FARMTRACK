# Leave these as placeholders to run in demo mode (no database, nothing saved).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Map imagery, free tier, no credit card: https://cloud.maptiler.com
# Optional for development builds (they fall back to free test servers).
# Required for preview/production builds, which show no imagery without it.
EXPO_PUBLIC_MAPTILER_KEY=

# Cloud (EAS) builds do not read this file: set the same names with
# `npx eas-cli env:set` for each environment (see README section 6).
