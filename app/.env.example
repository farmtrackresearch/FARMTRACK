EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — free tier, no credit card: https://cloud.maptiler.com
# Without this, the map's "Standard" mode falls back to OpenTopoMap, a
# volunteer-run free tile source not meant for deployed-app traffic.
EXPO_PUBLIC_MAPTILER_KEY=
